{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run audit)",
      "Bash(npm audit)",
      "Bash(npm ls*)",
      "Bash(git status*)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(./.env*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.js\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-html-sinks.js\"" },
          { "type": "command", "command": "npm --prefix \"$CLAUDE_PROJECT_DIR\" test --silent" }
        ]
      }
    ]
  }
}
